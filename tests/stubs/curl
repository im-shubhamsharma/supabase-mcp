#!/usr/bin/env bash
# Test stub for `curl` against the Supabase Management API. Returns canned
# fixtures keyed by the bearer token, and simulates `curl -f` failure (exit 22)
# for a token containing "BAD". Never makes a network call.
set -u

url=""; token=""
prev=""
for a in "$@"; do
  case "$a" in http*://*) url="$a" ;; esac
  case "$prev" in
    -H) case "$a" in "Authorization: Bearer "*) token="${a#Authorization: Bearer }" ;; esac ;;
  esac
  prev="$a"
done

# Invalid / revoked token -> curl -fsS fails
case "$token" in
  *BAD*) echo "curl: (22) The requested URL returned error: 401" >&2; exit 22 ;;
esac

# Account is encoded in the fixture token, e.g. TOKEN_personal -> personal
acct="${token#TOKEN_}"
path="${url#*api.supabase.com}"
path="${path%%\?*}"

emit() { printf '%s\n' "$1"; }

case "$acct:$path" in
  personal:/v1/organizations)
    emit '[{"id":"org_p","name":"Personal"}]' ;;
  personal:/v1/projects)
    emit '[{"id":"refP1","name":"personal-app","organization_id":"org_p","region":"us-east-1"}]' ;;

  company:/v1/organizations)
    emit '[{"id":"org_c","name":"Company Inc"}]' ;;
  company:/v1/projects)
    emit '[{"id":"refC1","name":"company-app","organization_id":"org_c","region":"eu-west-1"},{"id":"refC2","name":"company-staging","organization_id":"org_c","region":"eu-west-1"}]' ;;
  company:/v1/projects/refC1/branches)
    emit '[{"id":"brC1","name":"preview","project_ref":"refC1","is_default":false,"status":"ACTIVE_HEALTHY"},{"id":"brC1d","name":"main","project_ref":"refC1","is_default":true,"status":"ACTIVE_HEALTHY"}]' ;;

  *:/v1/organizations) emit '[]' ;;
  *:/v1/projects) emit '[]' ;;
  *:*/branches) emit '[]' ;;
  *) echo "curl stub: unmapped $acct:$path" >&2; exit 7 ;;
esac
