#!/usr/bin/env bash
# Test stub for Linux `secret-tool` (libsecret). Backs onto files under
# $SUPA_MCP_TEST_KC so the Linux keychain code path can be exercised on any OS.
set -u
store="${SUPA_MCP_TEST_KC:?SUPA_MCP_TEST_KC not set}"
mkdir -p "$store"

sub="${1:-}"; shift || true
# Remaining args are: [--label=..] service supa-mcp account <acct>
acct=""
prev=""
for a in "$@"; do
  case "$prev" in account) acct="$a" ;; esac
  prev="$a"
done
file="$store/$acct"

case "$sub" in
  store)
    # token comes on stdin
    cat > "$file" ;;
  lookup)
    [ -f "$file" ] || exit 1
    cat "$file" ;;
  clear)
    rm -f "$file" ;;
  *) exit 1 ;;
esac
